# Copie este archivo como .env y complete los valores. El archivo .env NO se sube a git.

# Secreto de firma de tokens JWT (obligatorio). Genere uno aleatorio con:  openssl rand -base64 48
APP_JWT_SECRET=

# Clave AES-256 (obligatoria) para cifrar secretos guardados en la base, como las contraseñas de impresoras. Genere una con:
#   openssl rand -base64 32
# HAGA COPIA: sin ella esas contraseñas no se pueden descifrar (habría que reingresarlas).
APP_CIFRADO_CLAVE=

# Opcional: contraseña inicial de los usuarios admin/owner cuando se crean por primera vez.
# Si se deja vacío, se genera una aleatoria que se muestra UNA vez en el log de la API (docker logs heladeria-api).
# En ambos casos el usuario debe cambiarla en su primer ingreso.
APP_SECURITY_DEFAULT_ADMIN_PASSWORD=
APP_SECURITY_DEFAULT_OWNER_PASSWORD=

# Opcional: carpeta del host (NAS, disco USB, montaje de red) para la copia externa de los respaldos.
# BACKUP_EXTERNAL_DIR=/mnt/nas/respaldos

# Contraseña del usuario "postgres" de la base de datos (obligatoria). Genere una con:  openssl rand -hex 24
# Se aplica al CREAR el volumen de la base; en una base ya creada habría que cambiarla con ALTER USER.
POSTGRES_PASSWORD=

# Contraseña del usuario de solo lectura "consulta" para DBeaver (opcional; vacío = no se crea).
# El puerto 5435 solo escucha en 127.0.0.1: se conecta desde el propio servidor.
DB_CONSULTA_PASSWORD=

# Instalación limpia por defecto: la base arranca sin catálogo de ejemplo (solo roles, usuarios admin/owner,
# páginas, categorías, la caja 1 y "Consumidor Final"). Poner true solo en un equipo de pruebas.
# APP_SEED_DATOS_DEMO=false
